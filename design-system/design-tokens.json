  "typography": {
    "fontFamily": {
      "display": "Poppins",
      "body": "Inter",
      "mono": "JetBrains Mono, ui-monospace, monospace",
      "fallback": "Arial, system-ui, sans-serif",
      "_nota": "Poppins para H1-H4/titulos de card. Inter para parrafos, tablas, formularios, botones, badges. Mono para codigos OS/OC, expedientes SIGED, RUCs y montos tabulares."
    },
    "fontWeightMap": {
      "Regular": 400, "Medium": 500, "SemiBold": 600, "Bold": 700, "ExtraBold": 800
    },
    "unidad_recomendada": "rem (base 16px) en vez de px fijo, por WCAG 1.4.4",
    "scale_web": {
      "h1": { "fontFamily": "display", "size": 36, "lineHeight": 40, "weight": "SemiBold" },
      "h2": { "fontFamily": "display", "size": 30, "lineHeight": 36, "weight": "SemiBold" },
      "h3": { "fontFamily": "display", "size": 24, "lineHeight": 32, "weight": "SemiBold" },
      "h4": { "fontFamily": "display", "size": 20, "lineHeight": 28, "weight": "SemiBold" },
      "h5_label": {
        "fontFamily": "body", "size": 16, "lineHeight": 22, "weight": "Medium",
        "_fix": "Original era 14/20, casi igual al parrafo (16/24) — poco salto jerarquico. Ajustado a 16/22 y reclasificado como Label, no Heading."
      },
      "paragraphRegular": { "fontFamily": "body", "size": 16, "lineHeight": 24, "weight": "Regular" },
      "paragraphSemiBold": { "fontFamily": "body", "size": 16, "lineHeight": 24, "weight": "SemiBold" },
      "paragraphBold": { "fontFamily": "body", "size": 16, "lineHeight": 24, "weight": "Bold" },
      "buttonXsmall": { "fontFamily": "body", "size": 12, "lineHeight": 16, "weight": "Medium" },
      "buttonSmall": { "fontFamily": "body", "size": 14, "lineHeight": 20, "weight": "Medium" },
      "buttonMedium": { "fontFamily": "body", "size": 16, "lineHeight": 24, "weight": "Medium" },
      "buttonLarge": { "fontFamily": "display", "size": 24, "lineHeight": 32, "weight": "Medium", "_restriccion": "Solo landing/hero/CTA de marketing. No usar en pantallas operativas del sistema." },
      "buttonXlarge": { "fontFamily": "display", "size": 32, "lineHeight": 40, "weight": "Medium", "_restriccion": "Solo landing/hero/CTA de marketing." },
      "componentsXsmall": { "fontFamily": "body", "size": 8, "lineHeight": 14, "weight": "Medium", "_restriccion": "Solo elementos decorativos (ej. punto numerico de contador). Nunca texto con informacion que el usuario deba leer." },
      "componentsSmall": { "fontFamily": "body", "size": 10, "lineHeight": 18, "weight": "Medium" },
      "componentsMedium": { "fontFamily": "body", "size": 12, "lineHeight": 20, "weight": "Medium" },
      "componentsLarge": { "fontFamily": "body", "size": 14, "lineHeight": 22, "weight": "Medium" },
      "componentsXlarge": { "fontFamily": "body", "size": 16, "lineHeight": 24, "weight": "Medium" }
    },
    "letterSpacing": {
      "default": 0,
      "uppercaseLabelsChips": "+0.04em",
      "_nota": "Agregar tracking positivo solo cuando el texto se muestre en MAYUSCULAS (badges de estado, eyebrows). El resto se mantiene en 0."
    }
  },

  "iconSize": {
    "_regla": "El tamano del icono siempre es igual al lineHeight del texto que lo acompana.",
    "derivadoDe": [
      { "contexto": "badge/chip pequeno", "ligadoA": "componentsSmall", "lineHeight": 18, "iconSize": 18 },
      { "contexto": "badge/chip normal", "ligadoA": "componentsMedium", "lineHeight": 20, "iconSize": 20 },
      { "contexto": "item de menu / rail", "ligadoA": "componentsXlarge", "lineHeight": 24, "iconSize": 24 },
      { "contexto": "boton medium", "ligadoA": "buttonMedium", "lineHeight": 24, "iconSize": 24 },
      { "contexto": "titulo de card (H4)", "ligadoA": "h4", "lineHeight": 28, "iconSize": 28 },
      { "contexto": "boton large (marketing)", "ligadoA": "buttonLarge", "lineHeight": 32, "iconSize": 32 }
    ]
  },

  "breakpoints": {
    "_descripcion": "Puntos de corte responsivos oficiales OEFA para adaptación en dispositivos.",
    "sm": { "value": "640px", "token": "--oefa-breakpoint-sm", "target": "Móvil / Celular", "behavior": "Formularios 1 columna, botones 100% ancho, títulos compactos." },
    "md": { "value": "768px", "token": "--oefa-breakpoint-md", "target": "Tablet vertical", "behavior": "Menú lateral colapsable / drawer, scroll horizontal táctil en tablas." },
    "lg": { "value": "1024px", "token": "--oefa-breakpoint-lg", "target": "Tablet horizontal / Laptop", "behavior": "Sidebar fijo (pinned), layout login conmuta a 1 columna centrada sin hero lateral." },
    "xl": { "value": "1280px", "token": "--oefa-breakpoint-xl", "target": "Desktop", "behavior": "Layout completo sin scroll horizontal forzado." },
    "touchTarget": { "minSize": "44px", "wcagAbsoluteMin": "24px", "standard": "WCAG 2.2 SC 2.5.8" }
  },

  "motion": {
    "_descripcion": "Curvas y duraciones Material 3 Expressive para micro-interacciones, transiciones y animaciones fluidas.",
    "easing": {
      "linear": { "value": "cubic-bezier(0, 0, 1, 1)", "token": "--oefa-ease-linear", "uso": "Progreso lineal / rotaciones continuas (spinners)." },
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)", "token": "--oefa-ease-standard", "uso": "Hover de botones, checkboxes, inputs y chips." },
      "standardDecelerate": { "value": "cubic-bezier(0, 0, 0.2, 1)", "token": "--oefa-ease-standard-decel", "uso": "Elementos que entran al viewport suavemente." },
      "standardAccelerate": { "value": "cubic-bezier(0.3, 0, 1, 1)", "token": "--oefa-ease-standard-accel", "uso": "Elementos que salen del viewport." },
      "emphasized": { "value": "cubic-bezier(0.2, 0, 0, 1)", "token": "--oefa-ease-emphasized", "uso": "Elevaciones con resorte suave, cards bento, modales y drawers." },
      "emphasizedDecelerate": { "value": "cubic-bezier(0.05, 0.7, 0.1, 1)", "token": "--oefa-ease-emphasized-decel", "uso": "Apertura prominente de flyouts y modales." },
      "emphasizedAccelerate": { "value": "cubic-bezier(0.3, 0, 0.8, 0.15)", "token": "--oefa-ease-emphasized-accel", "uso": "Cierre rápido de elementos superpuestos." }
    },
    "duration": {
      "short1": { "value": "50ms", "token": "--oefa-duration-short-1" },
      "short2": { "value": "100ms", "token": "--oefa-duration-short-2" },
      "short3": { "value": "150ms", "token": "--oefa-duration-short-3" },
      "short4": { "value": "200ms", "token": "--oefa-duration-short-4" },
      "short": { "value": "150ms", "token": "--oefa-duration-short", "uso": "Feedback táctil inmediato, active states, micro-checkmarks." },
      "medium1": { "value": "250ms", "token": "--oefa-duration-medium-1" },
      "medium2": { "value": "300ms", "token": "--oefa-duration-medium-2" },
      "medium": { "value": "300ms", "token": "--oefa-duration-medium", "uso": "Transiciones de hover, expansión de cards, morphing y toasts." },
      "long1": { "value": "350ms", "token": "--oefa-duration-long-1" },
      "long2": { "value": "400ms", "token": "--oefa-duration-long-2" },
      "long": { "value": "450ms", "token": "--oefa-duration-long", "uso": "Entrada y salida de modales completos, drawers laterales." }
    },
    "microInteractions": {
      "iconTilt": {
        "degree": "8deg",
        "scale": 1.12,
        "duration": "var(--oefa-duration-medium)",
        "easing": "var(--oefa-ease-emphasized)",
        "uso": "Contenedores interactivos de selección o destino (bento, catalog, selection, launcher, dropzone)."
      }
    }
  },

  "components": {
    "_nota": "Tokens de componentes reutilizables. Fuente de verdad para todos los proyectos OEFA basados en este starter.",

    "bentoKpiTile": {
      "_descripcion": "Tarjeta métrica Bento con esquinas de 20px, rellenos pastel suaves (4-8% tint), micro-gráficos (donut, gauge, bars, sparkline) y transiciones elásticas M3.",
      "borderRadius": "20px",
      "padding": "20px",
      "shadowDefault": "0 10px 30px -10px rgba(15, 23, 42, 0.04)",
      "shadowHover": "0 20px 40px -10px rgba(15, 23, 42, 0.10)",
      "transition": "transform var(--oefa-duration-medium) var(--oefa-ease-emphasized), box-shadow var(--oefa-duration-medium) var(--oefa-ease-emphasized)",
      "iconHoverTransform": "rotate(8deg) scale(1.12)",
      "microCharts": ["donut", "gauge", "bars", "sparkline"]
    },

    "catalogCard": {
      "_descripcion": "Tarjeta de catálogo Bento para tableros, módulos y sistemas con tags OEFA, micro-actividad (sparkline, bar, pulse) y acción fluida.",
      "borderRadius": "18px",
      "padding": "22px",
      "shadowDefault": "0 8px 24px -6px rgba(15, 23, 42, 0.04)",
      "shadowHover": "0 18px 36px -8px rgba(20, 74, 167, 0.12)",
      "transition": "transform var(--oefa-duration-medium) var(--oefa-ease-emphasized), box-shadow var(--oefa-duration-medium) var(--oefa-ease-emphasized), border-color var(--oefa-duration-short) var(--oefa-ease-standard)",
      "iconHoverTransform": "rotate(8deg) scale(1.12)"
    },

    "filterSidebar": {
      "_descripcion": "Panel lateral de filtrado avanzado facetado para escritorio y bottom sheet deslizable accesible para dispositivos móviles.",
      "desktopWidth": "280px",
      "borderRadiusDesktop": "16px",
      "borderRadiusMobile": "20px 20px 0 0",
      "maxHeightMobile": "88vh",
      "transition": "transform var(--oefa-duration-medium) var(--oefa-ease-emphasized)"
    },

    "tabs": {
      "_descripcion": "Sistema de pestanas con scroll horizontal automatico cuando no caben. Ver implementacion en styles.scss seccion GLOBAL TAB COMPONENT.",
      "variants": {
        "pill": {
          "_descripcion": "Fondo card con border-radius. Usado en: configuraciones, vistas con card contenedora.",
          "container": { "background": "surface-card", "border": "1px solid border-color", "borderRadius": "radius-md" },
          "nav": { "padding": "6px 8px", "gap": 0, "overflowX": "auto", "scrollbarVisible": false },
          "button": {
            "padding": "10px 18px",
            "fontSize": 14,
            "fontWeight": 500,
            "borderRadius": "radius-sm",
            "color": "text-secondary",
            "colorHover": "primary-root",
            "backgroundHover": "#F1F5F9",
            "backgroundActive": "primary-container",
            "colorActive": "primary-root",
            "fontWeightActive": 600
          }
        },
        "underline": {
          "_descripcion": "Borde inferior sin background solido. Usado en: order-detail, vistas de detalle con fondo blanco.",
          "container": { "borderBottom": "2px solid border-color" },
          "nav": { "padding": "0", "gap": "4px", "overflowX": "auto", "scrollbarVisible": false },
          "button": {
            "padding": "12px 20px",
            "fontSize": 15,
            "fontWeight": 600,
            "borderBottom": "3px solid transparent",
            "borderRadius": 0,
            "marginBottom": -2,
            "colorActive": "primary-root",
            "borderBottomActive": "3px solid primary-root",
            "fontWeightActive": 700
          }
        }
      },
      "badge": {
        "background": "#E2E8F0",
        "color": "text-secondary",
        "borderRadius": "100px",
        "padding": "1px 8px",
        "fontSize": 12,
        "fontWeight": 600,
        "backgroundActive": "primary-root",
        "colorActive": "#FFFFFF",
        "dot": {
          "_descripcion": "Puntito indicador para alertas, novedades o cambios pendientes en la pestaña.",
          "size": "8px",
          "borderRadius": "50%",
          "danger": "#EF4444",
          "warning": "#F59E0B",
          "primary": "primary-root",
          "success": "#10B981"
        }
      },
